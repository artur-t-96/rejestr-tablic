[Unit]
Description=Dyna Rejestr Tablic - kolejka i wygasanie rezerwacji
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dyna
Group=dyna
WorkingDirectory=/opt/dyna/current
EnvironmentFile=/etc/dyna/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/dyna/current/.venv/bin/python manage.py expire_reservations
ExecStart=/opt/dyna/current/.venv/bin/python manage.py process_integrations
ExecStart=/opt/dyna/current/.venv/bin/python manage.py process_account_invitations
TimeoutStartSec=30min
TimeoutStopSec=180s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dyna
