# Zastep domeny i sciezki certyfikatu. Ten plik zawiera bloki dla kontekstu http.
log_format dyna '$remote_addr $request_method $uri $status $request_time';

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name rejestr.urzad.example;
    return 301 https://rejestr.urzad.example$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/dyna/tls/fullchain.pem;
    ssl_certificate_key /etc/dyna/tls/privkey.pem;
    return 444;
}
server {
    listen 443 ssl;
    server_name rejestr.urzad.example;
    ssl_certificate /etc/dyna/tls/fullchain.pem;
    ssl_certificate_key /etc/dyna/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 11m;
    access_log /var/log/nginx/dyna-access.log dyna;
    error_log /var/log/nginx/dyna-error.log warn;

    location /static/ {
        alias /opt/dyna/current/staticfiles/;
        add_header X-Content-Type-Options nosniff always;
        # Brak dlugiego cache: zasoby obecnie nie maja hashy w nazwach.
        add_header Cache-Control "public, max-age=300";
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Dyna-Client-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
        proxy_request_buffering on;
    }
}
