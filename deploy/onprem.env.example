# Skopiuj poza repozytorium. To nie są działające sekrety ani dane urzędu.
DJANGO_SETTINGS_MODULE=config.settings_onprem
DYNA_ENV=onprem
DJANGO_DEBUG=0
DYNA_DATA_DIR=/var/lib/dyna
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
APP_URL=https://rejestr.urzad.example
DJANGO_ALLOWED_HOSTS=rejestr.urzad.example
APP_REVISION=REPLACE_WITH_FULL_RELEASE_COMMIT_SHA
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=dyna
PGUSER=dyna_runtime
PGPASSWORD=REPLACE_OUTSIDE_REPOSITORY
# Dla zdalnej bazy ustaw obie wartości i właściwy certyfikat CA:
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/etc/dyna/postgresql-ca.pem
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.urzad.example
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=REPLACE
EMAIL_HOST_PASSWORD=REPLACE_OUTSIDE_REPOSITORY
DEFAULT_FROM_EMAIL=rejestr@urzad.example
PUBLIC_QUERY_LIMIT=30
PUBLIC_CAPTCHA_THRESHOLD=10
PUBLIC_CAPTCHA_COST=5000
# Uzupełnij po uzyskaniu rzeczywistych dostępów. Nie wpisuj sekretów do Git.
EZDRP_CONFIG_FILE=
EDOR_CONFIG_FILE=
SIGNING_CONFIG_FILE=
