[Unit]
Description=Dyna Rejestr Tablic - usuniecie wygaslych licznikow ochrony

[Service]
Type=oneshot
User=dyna
Group=dyna
WorkingDirectory=/opt/dyna/current
EnvironmentFile=/etc/dyna/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/dyna/current/.venv/bin/python manage.py purge_security_state --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dyna
